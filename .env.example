APP_NAME="E-Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eshop
DB_USERNAME=postgres
DB_PASSWORD=

# Redis Cache & Queue
CACHE_STORE=redis
CACHE_PREFIX=eshop_cache

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Mail (Optional)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@eshop.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_REGION=auto

# WhatsApp OTP via UltraMsg
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ULTRAMSG_ENABLED=true

# Firebase (SMS Fallback + FCM)
# Place your Firebase service account JSON in storage/ directory
FIREBASE_CREDENTIALS=firebase-credentials.json

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RATE_LIMIT_PER_HOUR=3

# API Settings
API_VERSION=v1
API_RATE_LIMIT=60

# Filament Admin Panel
FILAMENT_ADMIN_PATH=admin
FILAMENT_VENDOR_PATH=vendor

VITE_APP_NAME="${APP_NAME}"
